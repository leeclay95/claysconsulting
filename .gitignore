# This repo contains the site source and nothing else.
# Everything below stays on the local workstation.

# Planning and design docs — local reference, not shipped source
docs/

# Session scratch — brainstorming mockups
.superpowers/

# Prior-art reference from the earlier AWS approach.
# Leading slash anchors to the repo root — an unanchored "deploy.yml" would
# also swallow .github/workflows/deploy.yml.
aws-deployment-kit/
aws-deployment-kit-patreon.zip
/deploy.yml

# Generated: Worker binding types, regenerated by `npx wrangler types` in CI
worker-configuration.d.ts

# No JSON in the repo by default, so data and config files can't be committed
# by accident. The three exceptions below are load-bearing and cannot be
# removed without breaking the build:
#   package.json       npm refuses to operate without it
#   package-lock.json  `npm ci` in CI fails without it
#   tsconfig.json      astro check / astro build resolve types through it
*.json
!package.json
!package-lock.json
!tsconfig.json

# Node / Astro build output
node_modules/
dist/
.astro/
*.log

# Cloudflare
.wrangler/
.dev.vars

# Secrets — runtime secrets live in Cloudflare, never here
.env
.env.*

# Editor / OS
.vscode/
.idea/
.DS_Store
