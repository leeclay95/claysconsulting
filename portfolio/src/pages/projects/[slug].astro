---
import Base from '../../layouts/Base.astro';
import KubernetesGrcTopology from '../../components/KubernetesGrcTopology.astro';
import IamPrivescTopology from '../../components/IamPrivescTopology.astro';
import AzureGrcPipelineTopology from '../../components/AzureGrcPipelineTopology.astro';
import { projects } from '../../data/projects';

/** One diagram component per project that has one. Keyed by slug rather than
    a generic prop, since each diagram is hand-drawn for its own architecture. */
const TOPOLOGIES: Record<string, any> = {
  'kubernetes-grc-engineering': KubernetesGrcTopology,
  'iam-privilege-escalation-lab': IamPrivescTopology,
  'azure-grc-evidence-pipeline': AzureGrcPipelineTopology,
};

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const Topology = TOPOLOGIES[project.slug];
---

<Base title={`${project.title} | Lee Clayton`} description={project.summary}>
  <article class="section">
    <div class="wrap">
      <a class="back" href="/#projects">&larr; Back to projects</a>

      <h1 class="detail__title">{project.title}</h1>
      <p class="detail__summary">{project.summary}</p>

      <ul class="detail__stack">
        {project.stack.map((s) => <li class="label">{s}</li>)}
      </ul>

      <a class="btn btn--ghost detail__source" href={project.href} rel="noopener">
        Source on GitHub &rarr;
      </a>

      <h2 class="detail__h2">How it works</h2>
      <p class="detail__architecture">{project.detail.architecture}</p>

      {Topology && (
        <div class="detail__diagram">
          <Topology />
        </div>
      )}

      {project.detail.sections.map((section) => (
        <>
          <h2 class="detail__h2">{section.heading}</h2>
          {section.kind === 'text' ? (
            <p class="detail__architecture">{section.body}</p>
          ) : (
            <div class="table-wrap">
              <table class="detail__table">
                <thead>
                  <tr>
                    {section.columns.map((col) => <th>{col}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {section.rows.map((row) => (
                    <tr>
                      {row.map((cell) => <td>{cell}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      ))}
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--accent-soft);
  }

  .detail__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .detail__summary {
    margin-top: 1rem;
    font-size: 1.0625rem;
    max-width: var(--measure);
    color: var(--text);
  }

  .detail__stack {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }

  .detail__source {
    margin-top: 1.5rem;
  }

  .detail__h2 {
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    font-size: 1.375rem;
  }

  .detail__architecture {
    max-width: var(--measure);
    font-size: 1rem;
  }

  .detail__diagram {
    margin-top: 1.5rem;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .detail__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    min-width: 40rem;
  }

  .detail__table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .detail__table td {
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .detail__table td:first-child,
  .detail__table td:nth-child(2) {
    color: var(--text);
    white-space: nowrap;
  }
</style>
