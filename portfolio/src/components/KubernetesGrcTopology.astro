---
/**
 * Hand-authored diagram of the Kubernetes GRC Engineering lab, redrawn from
 * the architecture in /home/kali/floci/k3-test/README.md for the web. Specific
 * to this one project on purpose: a generic multi-project diagram system
 * would be premature with a single lab documented.
 */
---

<div class="topology">
  <svg viewBox="0 0 1040 660" role="img" aria-label="Architecture diagram: Terraform provisions LocalStack and a k3d cluster; Argo CD reconciles the webapp namespace from Git; External Secrets Operator injects secrets from Secrets Manager; Gatekeeper enforces admission policy; the pod pulls its image from ECR.">
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="topo-arrowhead" />
      </marker>
    </defs>

    <!-- Terraform actor -->
    <rect x="20" y="20" width="140" height="50" rx="4" class="topo-box" />
    <text x="90" y="49" class="topo-box-title" text-anchor="middle">Terraform apply</text>

    <!-- Git repo actor -->
    <rect x="20" y="350" width="140" height="50" rx="4" class="topo-box" />
    <text x="90" y="371" class="topo-box-title" text-anchor="middle">Git repo</text>
    <text x="90" y="389" class="topo-box-sub" text-anchor="middle">charts/webapp</text>

    <!-- LocalStack tier -->
    <rect x="190" y="90" width="780" height="170" rx="6" class="topo-container" />
    <text x="210" y="115" class="topo-container-label">LocalStack (AWS emulation)</text>

    <rect x="210" y="130" width="340" height="90" rx="4" class="topo-box" />
    <text x="380" y="160" class="topo-box-title" text-anchor="middle">Secrets Manager + RDS</text>
    <text x="380" y="180" class="topo-box-sub" text-anchor="middle">KMS-encrypted, customer-managed CMK</text>
    <text x="380" y="198" class="topo-box-sub" text-anchor="middle">webapp/secrets, webapp/db-creds</text>

    <rect x="630" y="130" width="340" height="90" rx="4" class="topo-box" />
    <text x="800" y="160" class="topo-box-title" text-anchor="middle">ECR</text>
    <text x="800" y="180" class="topo-box-sub" text-anchor="middle">Private registry, immutable tags</text>
    <text x="800" y="198" class="topo-box-sub" text-anchor="middle">No public image pull at runtime</text>

    <!-- k3d cluster tier -->
    <rect x="190" y="300" width="780" height="340" rx="6" class="topo-container" />
    <text x="210" y="325" class="topo-container-label">k3d cluster: webapp-test</text>

    <rect x="210" y="350" width="220" height="70" rx="4" class="topo-box" />
    <text x="320" y="380" class="topo-box-title" text-anchor="middle">External Secrets</text>
    <text x="320" y="398" class="topo-box-sub" text-anchor="middle">assumes scoped eso-role</text>

    <rect x="460" y="350" width="220" height="70" rx="4" class="topo-box" />
    <text x="570" y="380" class="topo-box-title" text-anchor="middle">Gatekeeper</text>
    <text x="570" y="398" class="topo-box-sub" text-anchor="middle">admission policies</text>

    <rect x="710" y="350" width="220" height="70" rx="4" class="topo-box" />
    <text x="820" y="380" class="topo-box-title" text-anchor="middle">Argo CD</text>
    <text x="820" y="398" class="topo-box-sub" text-anchor="middle">single reconciler, self-heals drift</text>

    <rect x="210" y="480" width="760" height="140" rx="4" class="topo-box" />
    <text x="230" y="505" class="topo-box-title">webapp namespace</text>
    <text x="230" y="528" class="topo-box-sub">ServiceAccount webapp-sa (automountServiceAccountToken=false)</text>
    <text x="230" y="548" class="topo-box-sub">Pod: ECR image, readOnlyRootFilesystem</text>
    <text x="230" y="568" class="topo-box-sub">env SECRET_KEY, DB_PASSWORD, DB_URL &lt;- K8s Secrets</text>
    <text x="230" y="596" class="topo-box-title">NodePort 30080 -&gt; container 8080</text>

    <!-- Arrows -->
    <path d="M80,70 V110 H190" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="90" y="102" class="topo-arrow-label">provisions</text>

    <path d="M110,70 V320 H190" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="125" y="308" class="topo-arrow-label">installs controllers</text>

    <path d="M320,220 V350" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="333" y="280" class="topo-arrow-label">GetSecretValue via eso-role</text>

    <path d="M320,420 V480" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="333" y="450" class="topo-arrow-label">K8s Secrets</text>

    <path d="M570,420 V480" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="583" y="450" class="topo-arrow-label">blocks at apply time</text>

    <!-- Routed below the controllers row (y440 sits in the clear gap between
         it and the webapp box) so this line never crosses their titles. -->
    <path d="M160,375 V440 H700 V385 H710" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="380" y="433" class="topo-arrow-label">git pull</text>

    <path d="M820,420 V480" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="833" y="450" class="topo-arrow-label">sync + self-heal</text>

    <path d="M850,220 H1010 V500 H970" class="topo-arrow" marker-end="url(#arrow)" />
    <text x="915" y="209" class="topo-arrow-label">image pull</text>
  </svg>
</div>

<style>
  .topology {
    overflow-x: auto;
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 1rem;
  }

  .topology svg {
    display: block;
    width: 100%;
    min-width: 46rem;
    height: auto;
    font-family: var(--font-mono);
  }

  .topo-container {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
  }

  .topo-container-label {
    fill: var(--text-dim);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .topo-box {
    fill: var(--bg-deep);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .topo-box-title {
    fill: var(--text);
    font-size: 13px;
  }

  .topo-box-sub {
    fill: var(--text-muted);
    font-size: 10.5px;
  }

  .topo-arrow {
    fill: none;
    stroke: var(--accent-soft);
    stroke-width: 1.5;
  }

  .topo-arrow-label {
    fill: var(--text-dim);
    font-size: 10.5px;
  }

  .topo-arrowhead {
    fill: var(--accent-soft);
  }
</style>
